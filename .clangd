CompileFlags:
  CompilationDatabase: build
  Add:
    - -std=c++23
    - -IRender
    - -ISandBox/SDL/include
    - -Ibuild/SandBox/SDL/include-revision
    - -IE:/Vulkan/include
    <!-- - -I${env:VULKAN_SDK}/include -->
    - -include
    - vulkan/vulkan.h

Index:
  Background: Build

Completion:
  AllScopes: Yes
  HeaderInsertion: IWYU